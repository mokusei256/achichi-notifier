# コピーして .env を作成: cp .env.example .env
# 主系の PC（Windows）と予備系の Mac で同じ値を使う。値はチャット・クラウドに貼らない

# --- Discord（必須） -------------------------------------------------------
# Developer Portal > Bot > Reset Token で取得。絶対に公開しないこと
DISCORD_BOT_TOKEN=
# 通知を流すチャンネルの ID（開発者モードで右クリック > ID をコピー）
DISCORD_CHANNEL_ID=
# 既読状態を保存するプライベートチャンネルの ID（Bot だけが見えるチャンネル推奨）
DISCORD_STATE_CHANNEL_ID=

# --- 種類ごとに投稿先を分けたい場合（任意。未設定なら DISCORD_CHANNEL_ID）
# DISCORD_CHANNEL_ID_VIDEO=
# DISCORD_CHANNEL_ID_SHORT=
# DISCORD_CHANNEL_ID_LIVE=
# DISCORD_CHANNEL_ID_POST=

# --- メンション（任意）。ロールは <@&ロールID>、全員は @everyone
# MENTION_VIDEO=<@&123456789012345678>
# MENTION_SHORT=
# MENTION_LIVE=<@&123456789012345678>
# MENTION_POST=
# メン限投稿だけ別のメンションにしたい場合（未設定なら MENTION_POST）
# MENTION_MEMBER_POST=

# --- YouTube ---------------------------------------------------------------
# メン限投稿の検知用 Cookie（メンバー加入済みアカウント、Netscape 形式 cookies.txt）
# 自宅の PC にだけ置く。install.ps1 / install.sh がこの行を自動で設定するので、通常は書かなくてよい
# YOUTUBE_COOKIES_FILE=/Users/you/Library/Application Support/achichi-notifier/cookies.txt
# 環境変数で渡す場合（base64 でも cookies.txt の中身そのままでも可。非推奨）
# YOUTUBE_COOKIES_B64=
# Bot 用 Firefox プロファイル（install.ps1 -FirefoxProfile が自動で設定。設定するとこれが最優先）
# YOUTUBE_FIREFOX_PROFILE=C:\Users\you\AppData\Local\achichi-notifier\firefox-profile
# FIREFOX_EXE=C:\Program Files\Mozilla Firefox\firefox.exe
# 毎日の自動更新で YouTube を開いておく秒数（ログの PSIDTS rotated=False が続くなら 660 に）
# FIREFOX_REFRESH_SECONDS=150
# 監視チャンネル（既定: @AchichiMela）
# YOUTUBE_CHANNEL_ID=UC8eitCE9Z6EwUCs-VUi1blg

# --- 動作調整（任意） --------------------------------------------------------
# 予備系(Mac) は主系の最終成功からこの分数が経つまで全体の確認をしない
# FALLBACK_AFTER_MINUTES=15
# これより古い動画・投稿は「初めて見つけても」通知しない（取りこぼし時の大量通知防止）
# 配信枠・プレミアは開始予定時刻、アーカイブは配信の終了時刻で判断する（配信中は常に通知）
# MAX_AGE_HOURS=72
# 予備系(Mac) が主系の正常時にメン限投稿だけを確認する間隔（分）
# MEMBER_CHECK_MINUTES=10
# タイトルがこの正規表現に当てはまる配信（枠・配信中・アーカイブ）は通知しない（既定: フリーチャット等。none で無効）
# EXCLUDE_LIVE_TITLES=フリーチャット|フリチャ|ふりーちゃっと|free[\s_-]*chat
