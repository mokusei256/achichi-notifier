# コピーして .env を作成: cp .env.example .env
# （GitHub Actions では Secrets / Variables に同名で登録する。README 参照）

# --- Discord（必須） -------------------------------------------------------
# Developer Portal > Bot > Reset Token で取得。絶対に公開しないこと
DISCORD_BOT_TOKEN=
# 通知を流すチャンネルの ID（開発者モードで右クリック > ID をコピー）
DISCORD_CHANNEL_ID=
# 既読状態を保存するプライベートチャンネルの ID（Bot だけが見えるチャンネル推奨）
DISCORD_STATE_CHANNEL_ID=

# --- 種類ごとに投稿先を分けたい場合（任意。未設定なら DISCORD_CHANNEL_ID）
# DISCORD_CHANNEL_ID_VIDEO=
# DISCORD_CHANNEL_ID_SHORT=
# DISCORD_CHANNEL_ID_LIVE=
# DISCORD_CHANNEL_ID_POST=

# --- メンション（任意）。ロールは <@&ロールID>、全員は @everyone
# MENTION_VIDEO=<@&123456789012345678>
# MENTION_SHORT=
# MENTION_LIVE=<@&123456789012345678>
# MENTION_POST=
# メン限投稿だけ別のメンションにしたい場合（未設定なら MENTION_POST）
# MENTION_MEMBER_POST=

# --- YouTube ---------------------------------------------------------------
# メン限投稿の検知用 Cookie（メンバー加入済みアカウント、Netscape 形式 cookies.txt）
# 推奨は Mac だけで使うこと。deploy/mac/install.sh がこの行を自動で設定するので、通常は書かなくてよい
# YOUTUBE_COOKIES_FILE=/Users/you/Library/Application Support/achichi-notifier/cookies.txt
# GitHub Actions で使う場合の Secret（base64 でも cookies.txt の中身そのままでも可。非推奨）
# YOUTUBE_COOKIES_B64=
# 監視チャンネル（既定: @AchichiMela）
# YOUTUBE_CHANNEL_ID=UC8eitCE9Z6EwUCs-VUi1blg

# --- 動作調整（任意） --------------------------------------------------------
# Mac(予備系) は GitHub Actions の最終成功からこの分数が経つまで何もしない
# FALLBACK_AFTER_MINUTES=15
# これより古い動画・投稿は「初めて見つけても」通知しない（取りこぼし時の大量通知防止）
# MAX_AGE_HOURS=72
# Mac(予備系) が GitHub 正常時にメン限投稿だけを確認する間隔（分）
# MEMBER_CHECK_MINUTES=10
